{
  "name": "offline-invoice-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "オフライン完結型の見積書・請求書作成ツール（データは端末内のみに保存）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
