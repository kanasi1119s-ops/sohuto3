{
  "name": "minato-asaichi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "みなとのあさいち - 2人用ワーカープレイスメント（ブラウザゲーム）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "SINGLE=1 vite build",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "tsx scripts/simulate.ts",
    "zip": "npm run build && cd dist && zip -r ../minato-asaichi-html5.zip ."
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
